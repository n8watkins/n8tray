{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/n8watkins/n8tray/main/spec/schema/status.schema.json",
  "title": "N8 Tray app status, contract 2",
  "description": "What an app serves at GET /n8/v2/status or writes to <id>.status.json. See spec/contract-v2.md, section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "version", "updatedAt", "pid", "pidStartedAt", "state", "summary", "resources"],
  "properties": {
    "contract": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "pid": { "$ref": "#/$defs/pid" },
    "pidStartedAt": { "$ref": "#/$defs/timestamp" },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["events", "progress", "pressure", "presence"] }
    },
    "state": { "enum": ["ready", "idle", "starting", "degraded", "busy", "failed"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
    "detail": { "type": "string", "minLength": 1, "maxLength": 300 },
    "components": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "state"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "state": { "$ref": "#/$defs/state" },
          "detail": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "presence": {
      "type": "object",
      "required": ["lastSeenAt", "clients"],
      "properties": {
        "lastSeenAt": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "clients": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": { "type": ["string", "null"], "maxLength": 64 }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampledAt", "intervalSeconds", "processes"],
      "properties": {
        "sampledAt": { "$ref": "#/$defs/timestamp" },
        "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "processes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/process" }
        },
        "namespaces": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/namespacedProcess" }
        }
      }
    },
    "jobs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "state", "startedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "action": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,47}$" },
          "component": { "$ref": "#/$defs/id" },
          "state": { "enum": ["running", "done", "failed"] },
          "percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "message": { "type": "string", "maxLength": 200 },
          "startedAt": { "$ref": "#/$defs/timestamp" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
    "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "state": {
      "enum": ["ready", "idle", "starting", "degraded", "busy", "stopped", "failed", "not-installed", "needs-setup", "unsupported"]
    },
    "role": { "enum": ["main", "hub", "engine", "worker", "helper", "ui"] },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "startedAt", "parentPid", "role", "rssMb", "cpuPercent"],
      "properties": {
        "pid": { "$ref": "#/$defs/pid" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "parentPid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "role": { "$ref": "#/$defs/role" },
        "component": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "exe": { "type": "string", "minLength": 1, "maxLength": 260 },
        "rssMb": { "type": "number", "minimum": 0 },
        "privateMb": { "type": "number", "minimum": 0 },
        "cpuPercent": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memMb": { "type": "number", "minimum": 0 },
            "percent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["loaded"],
          "properties": {
            "loaded": { "type": "boolean" },
            "mb": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "namespacedProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "pid", "startedAt", "rssMb", "cpuPercent"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^wsl:[A-Za-z0-9._-]{1,64}$" },
        "pid": { "$ref": "#/$defs/pid" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "role": { "$ref": "#/$defs/role" },
        "component": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "exe": { "type": "string", "minLength": 1, "maxLength": 260 },
        "rssMb": { "type": "number", "minimum": 0 },
        "cpuPercent": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100 }, { "type": "null" }] }
      }
    }
  }
}
