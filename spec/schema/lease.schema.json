{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/n8watkins/n8tray/main/spec/schema/lease.schema.json",
  "title": "N8 Tray host lease, contract 2",
  "description": "The file host.json the host writes to the runtime folder every 5 s. See spec/contract-v2.md, section 8.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "host", "version", "pid", "pidStartedAt", "heartbeat", "hosting"],
  "properties": {
    "contract": { "const": 2 },
    "host": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "pidStartedAt": { "$ref": "#/$defs/timestamp" },
    "heartbeat": { "$ref": "#/$defs/timestamp" },
    "hosting": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    }
  }
}
