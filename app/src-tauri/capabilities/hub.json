{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hub",
  "description": "The hub window: it hears the snapshot and asks for actions through N8 Tray's own commands, nothing else. No plugin, file system, shell or HTTP access.",
  "windows": [
    "hub"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-module-action",
    "allow-open-item",
    "allow-hide-window",
    "allow-app-icon",
    "allow-set-setting",
    "allow-host-command",
    "allow-open-host",
    "allow-open-update",
    "allow-install-update",
    "allow-history",
    "allow-recent-warnings",
    "allow-status-text",
    "allow-fit-window",
    "allow-initial-view"
  ]
}
