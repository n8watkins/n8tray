// What Rust fills for All apps (lane: pinned apps, which owns this file
// with `all-apps.slint`): the global and every struct or enum it uses. No
// component in a model file (README, "Your types reach Rust").

// The kit's export chain: keep this line as it is.
export * from "panel-model.slint";

export global AllAppsModel {
    in-out property <string> note: "All apps comes with its own lane.";
}
