// About N8 Tray (lane: settings and about). A stub until that lane lands;
// it owns this file, `about-model.slint` and `src/view/about.rs`.
import { TitleBar, ScrollArea, Say, SayLine } from "../widgets.slint";
import { Nav } from "../nav.slint";
import { AboutModel } from "about-model.slint";

export component AboutView inherits VerticalLayout {
    TitleBar {
        title: "About N8 Tray";
        back: true;
        back-clicked => {
            Nav.back();
        }
        close-clicked => {
            Nav.close();
        }
    }
    ScrollArea {
        Say {
            SayLine {
                text: "N8 Tray " + AboutModel.version;
            }
        }
    }
}
