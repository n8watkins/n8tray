// The hub (copies `Hub.tsx`, `HubHead`, `HubFoot` and `UpdateBanner.tsx`):
// the title bar with the level pill and the summary, the amber line when
// something is wrong, then in the scroll area the watching note, the update
// banner, the main view's apps, the manifest problems, the more line and N8
// Tray's own row, and the bottom bar. Words and numbers come from Rust
// (`view::hub`); the product name is the title bar's own default.
import { Theme, TitleBar, ScrollArea, Banner, BannerKind, AlertLine, GlyphName, RowList, AppRow, ProblemRow, MoreLine, Divider, BottomBar, WrapLabel } from "../widgets.slint";
import { Nav, View } from "../nav.slint";
import { HubModel } from "hub-model.slint";

export component HubView inherits VerticalLayout {
    TitleBar {
        show-pill: true;
        level: HubModel.level;
        level-text: HubModel.level-text;
        summary: HubModel.summary;
        summary-label: HubModel.summary-label;
        show-settings: true;
        summary-clicked => {
            Nav.go(View.details, "");
        }
        settings-clicked => {
            Nav.go(View.settings, "");
        }
        close-clicked => {
            Nav.close();
        }
    }
    if HubModel.alert != "": HorizontalLayout {
        padding-left: Theme.gutter;
        padding-right: Theme.gutter;
        padding-bottom: Theme.section-gap;
        AlertLine {
            text: HubModel.alert;
        }
    }
    ScrollArea {
        VerticalLayout {
            if HubModel.watching: VerticalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                padding-bottom: Theme.banner-gap;
                Banner {
                    glyph: GlyphName.info;
                    text: "Your PowerShell N8 Tray is managing these apps. This app is watching only; nothing here starts or stops apps.";
                    link: "Learn more";
                    link-open: "Show less";
                    more: "Both trays read the same apps. Until this one replaces the PowerShell tray, it only shows their state and memory, so the two never fight over an app. Exit the PowerShell N8 Tray and this one manages them.";
                }
            }
            if HubModel.update-shown: VerticalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                padding-bottom: Theme.banner-gap;
                Banner {
                    kind: HubModel.update-problem ? BannerKind.problem : BannerKind.info;
                    glyph: GlyphName.update;
                    text: HubModel.update-text;
                    detail: HubModel.update-detail;
                    progress: HubModel.update-progress;
                    secondary: HubModel.update-secondary;
                    primary: HubModel.update-primary;
                    secondary-clicked => {
                        HubModel.update-secondary-clicked();
                    }
                    primary-clicked => {
                        HubModel.update-primary-clicked();
                    }
                }
            }

            // `.list { padding: 2px 6px 4px }` and `.flyout-inner`'s own
            // 6 px at the bottom, inside the scroll area as today's, so the
            // last row scrolls up to its own room above the bottom bar.
            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 2px;
                padding-bottom: 4px + 6px;

                // `<p class="empty">`: `padding: 24px 16px` inside the list's
                // 6, plus the paragraph's default margin of 1em (13 px) above
                // and below.
                if HubModel.empty != "": VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 24px + Theme.text-body;
                    padding-bottom: 24px + Theme.text-body;
                    WrapLabel {
                        text: HubModel.empty;
                        color: Theme.muted;
                        accessible-role: AccessibleRole.text;
                        accessible-label: self.text;
                    }
                }
                RowList {
                    rows: HubModel.rows;
                    first-index: 0;
                    total: HubModel.rows.length + 1;
                    open(id) => {
                        Nav.go(View.panel, id);
                    }
                    act(id) => {
                        HubModel.act(id);
                    }
                }
                for problem in HubModel.problems: ProblemRow {
                    name: problem.name;
                    message: problem.message;
                }
                if HubModel.more != "": MoreLine {
                    text: HubModel.more;
                    clicked => {
                        Nav.go(View.all-apps, "");
                    }
                }
                Divider { }
                AppRow {
                    app-id: HubModel.tray.id;
                    index: HubModel.rows.length;
                    total: HubModel.rows.length + 1;
                    name: HubModel.tray.name;
                    line: HubModel.tray.line;
                    tone: HubModel.tray.tone;
                    memory: HubModel.tray.memory;
                    sub: HubModel.tray.sub;
                    spark-line: HubModel.tray.spark-line;
                    spark-fill: HubModel.tray.spark-fill;
                    level: HubModel.tray.level;
                    icon: HubModel.tray.icon;
                    tooltip: HubModel.tray.tooltip;
                    label: HubModel.tray.label;
                    clicked => {
                        Nav.go(View.details, "");
                    }
                }
            }
        }
    }
    BottomBar {
        switch-text: HubModel.sign-in-text;
        switch-checked: HubModel.sign-in-checked;
        switch-enabled: HubModel.sign-in-enabled;
        switch-tooltip: HubModel.sign-in-tooltip;
        links: HubModel.links;
        switch-toggled => {
            HubModel.toggle-sign-in();
        }
        link-clicked(key) => {
            if key == "history" {
                Nav.go(View.history, "");
            } else {
                HubModel.open-log();
            }
        }
    }
}
