// The hub (lane: hub screen). Until that lane lands, the placeholder of lane
// N0: the level, the headline and each app as plain text, in the kit's
// title bar. The hub lane owns this file, `hub-model.slint` and
// `src/view/hub.rs`, and replaces them.
import { Theme, TitleBar, ScrollArea, Say, SayLine } from "../widgets.slint";
import { Nav, View } from "../nav.slint";
import { HubModel } from "hub-model.slint";

export component HubView inherits VerticalLayout {
    TitleBar {
        show-pill: true;
        level: HubModel.level;
        level-text: HubModel.level-text;
        summary: HubModel.summary;
        show-settings: true;
        summary-clicked => {
            Nav.go(View.details, "");
        }
        settings-clicked => {
            Nav.go(View.settings, "");
        }
        close-clicked => {
            Nav.close();
        }
    }
    ScrollArea {
        Say {
            for line in HubModel.lines: SayLine {
                text: line.text;
                color: line.strong ? Theme.fg : Theme.muted;
            }
        }
    }
}
