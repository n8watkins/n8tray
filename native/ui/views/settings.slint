// Settings (lane: settings and about). A stub until that lane lands; it
// owns this file, `settings-model.slint` and `src/view/settings.rs`.
import { TitleBar, ScrollArea, Say, SayLine } from "../widgets.slint";
import { Nav } from "../nav.slint";
import { SettingsModel } from "settings-model.slint";

export component SettingsView inherits VerticalLayout {
    TitleBar {
        title: "Settings";
        back: true;
        back-clicked => {
            Nav.back();
        }
        close-clicked => {
            Nav.close();
        }
    }
    ScrollArea {
        Say {
            SayLine {
                text: SettingsModel.note;
            }
        }
    }
}
