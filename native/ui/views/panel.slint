// One app's panel (lane: app panel). A stub until that lane lands; it owns
// this file, `panel-model.slint` and `src/view/panel.rs`.
import { TitleBar, ScrollArea, Say, SayLine } from "../widgets.slint";
import { Nav } from "../nav.slint";
import { PanelModel } from "panel-model.slint";

export component PanelView inherits VerticalLayout {
    TitleBar {
        title: PanelModel.name;
        back: true;
        show-icon: true;
        icon: PanelModel.icon;
        icon-level: PanelModel.level;
        show-pill: true;
        level: PanelModel.level;
        level-text: PanelModel.words;
        back-clicked => {
            Nav.back();
        }
        close-clicked => {
            Nav.close();
        }
    }
    ScrollArea {
        Say {
            SayLine {
                text: PanelModel.note;
            }
        }
    }
}
