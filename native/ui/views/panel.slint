// One app's panel (lane: app panel). A stub until that lane lands; it owns
// this file and `src/view/panel.rs`.
import { Level, TitleBar, ScrollArea, Say, SayLine } from "../widgets.slint";
import { Nav } from "../nav.slint";

export global PanelModel {
    in-out property <string> name;
    in-out property <image> icon;
    in-out property <Level> level: Level.off;
    in-out property <string> words;
    in-out property <string> note: "The app's panel comes with its own lane.";
}

export component PanelView inherits VerticalLayout {
    TitleBar {
        title: PanelModel.name;
        back: true;
        show-icon: true;
        icon: PanelModel.icon;
        icon-level: PanelModel.level;
        show-pill: true;
        level: PanelModel.level;
        level-text: PanelModel.words;
        back-clicked => {
            Nav.back();
        }
        close-clicked => {
            Nav.close();
        }
    }
    ScrollArea {
        Say {
            SayLine {
                text: PanelModel.note;
            }
        }
    }
}
