// Status details (lane: details). A stub until that lane lands; it owns
// this file, `details-model.slint` and `src/view/details.rs`.
import { TitleBar, ScrollArea, Say, SayLine } from "../widgets.slint";
import { Nav } from "../nav.slint";
import { DetailsModel } from "details-model.slint";

export component DetailsView inherits VerticalLayout {
    TitleBar {
        title: "Status details";
        back: true;
        back-clicked => {
            Nav.back();
        }
        close-clicked => {
            Nav.close();
        }
    }
    ScrollArea {
        Say {
            SayLine {
                text: DetailsModel.note;
            }
        }
    }
}
