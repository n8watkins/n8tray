// What Rust fills for an app's panel (lane: app panel, which owns this file
// with `panel.slint`): the global and every struct or enum it uses. No
// component in a model file (README, "Your types reach Rust").

// The kit's export chain: keep this line as it is.
export * from "details-model.slint";

import { Level } from "../widgets.slint";

export global PanelModel {
    in-out property <string> name;
    in-out property <image> icon;
    in-out property <Level> level: Level.off;
    in-out property <string> words;
    in-out property <string> note: "The app's panel comes with its own lane.";
}
