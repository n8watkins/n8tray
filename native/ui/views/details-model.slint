// What Rust fills for the status details (lane: details, which owns this
// file with `details.slint`): the global and every struct or enum it uses.
// No component in a model file (README, "Your types reach Rust").

// The kit's export chain: keep this line as it is.
export * from "settings-model.slint";

export global DetailsModel {
    in-out property <string> note: "Status details come with their own lane.";
}
