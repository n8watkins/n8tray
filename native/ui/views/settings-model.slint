// What Rust fills for Settings (lane: settings and about, which owns this
// file with `settings.slint`): the global and every struct or enum it uses.
// No component in a model file (README, "Your types reach Rust").

// The kit's export chain: keep this line as it is.
export * from "about-model.slint";

export global SettingsModel {
    in-out property <string> note: "Settings come with their own lane.";
}
