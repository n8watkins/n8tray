// The pieces every widget is made of: glyphs, text in CSS line boxes, the
// focus ring, the press-and-focus behaviour of every control, and the
// window-wide hand-offs (tooltips, and where the focus is for the keyboard
// test).
import { Theme } from "../theme.slint";

// The window's own small glyphs (app/ui/src/components/Glyph.tsx), 16 x 16,
// recoloured with `colorize`. Decorative only: every control that shows
// one has its own accessible label. `box-check` is the bottom bar's ticked
// box (approved 2026-11-26).
export enum GlyphName {
    none, play, stop, restart, back, close, gear, check, box, box-check,
    history, file, folder, web, copy, info, update, chevron,
}

export component Glyph inherits Image {
    in property <GlyphName> name;
    in property <length> size: Theme.glyph;
    width: root.size;
    height: root.size;
    accessible-role: none;
    source: root.name == GlyphName.play ? @image-url("../glyphs/play.svg")
        : root.name == GlyphName.stop ? @image-url("../glyphs/stop.svg")
        : root.name == GlyphName.restart ? @image-url("../glyphs/restart.svg")
        : root.name == GlyphName.back ? @image-url("../glyphs/back.svg")
        : root.name == GlyphName.close ? @image-url("../glyphs/close.svg")
        : root.name == GlyphName.gear ? @image-url("../glyphs/gear.svg")
        : root.name == GlyphName.check ? @image-url("../glyphs/check.svg")
        : root.name == GlyphName.box ? @image-url("../glyphs/box.svg")
        : root.name == GlyphName.box-check ? @image-url("../glyphs/box-check.svg")
        : root.name == GlyphName.history ? @image-url("../glyphs/history.svg")
        : root.name == GlyphName.file ? @image-url("../glyphs/file.svg")
        : root.name == GlyphName.folder ? @image-url("../glyphs/folder.svg")
        : root.name == GlyphName.web ? @image-url("../glyphs/web.svg")
        : root.name == GlyphName.copy ? @image-url("../glyphs/copy.svg")
        : root.name == GlyphName.info ? @image-url("../glyphs/info.svg")
        : root.name == GlyphName.update ? @image-url("../glyphs/update.svg")
        : @image-url("../glyphs/chevron.svg");
    visible: root.name != GlyphName.none;
    colorize: Theme.muted;
}

// One line of text in a CSS line box (font size x 1.4), elided at the end,
// as the window's `white-space: nowrap; text-overflow: ellipsis`.
export component Label inherits Text {
    font-size: Theme.text-body;
    color: Theme.fg;
    height: self.font-size * Theme.line-height;
    vertical-alignment: center;
    overflow: elide;
    wrap: no-wrap;
    accessible-role: none;
}

// Text that wraps (`white-space: normal`), up to `max-lines` lines, at the
// window's line height.
export component WrapLabel inherits Text {
    font-size: Theme.text-body;
    color: Theme.fg;
    wrap: word-wrap;
    overflow: elide;
    vertical-alignment: top;
    line-height-factor: Theme.line-factor;
    min-height: self.font-size * Theme.line-height;
    accessible-role: none;
}

// The focus ring: `outline: 2px solid var(--accent); outline-offset: -2px;
// border-radius: 5px`, drawn over the control, inside its edge.
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    border-width: root.shown ? Theme.focus-width : 0px;
    border-color: Theme.accent;
    border-radius: Theme.focus-radius;
    background: transparent;
}

// Where the control with the keyboard focus is, for the kit's keyboard test
// (`view::gallery::tests::tab_through`); nothing in the window reads it.
//
// Scrolling a focused control into view is Slint's own: when an item takes
// the focus, the window scrolls every Flickable around it so it shows
// (`publish_focus_item`, smooth unless Windows' animations are off). The
// kit adds no scrolling of its own, so there is one scroll, never two. The
// title bar and the bottom bar are outside the view's `ScrollArea`, so
// their controls never move the list.
//
// Every control says where it was when it took the focus, whether it is in
// a bar (`in-bar`), and where it is now while it keeps the focus (after the
// list scrolled for it); the scroll area says its visible part and how far
// it is scrolled.
export global FocusProbe {
    in-out property <length> focused-x;
    in-out property <length> focused-top;
    in-out property <length> focused-bottom;
    in-out property <bool> focused-in-bar;
    in-out property <int> focused-serial;
    in-out property <length> now-top;
    in-out property <length> now-bottom;
    in-out property <length> view-top;
    in-out property <length> view-bottom;
    in-out property <length> scrolled;
}

// The tooltip the window shows: set by a hovered control after a pause,
// drawn by the window's `TooltipLayer`.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    // The top of the control, for a tooltip that does not fit below it.
    in-out property <length> above;
    in-out property <bool> shown;
}

// A tooltip on something that is not a control (a table row, `title`):
// once per hover, after the pause.
export component TipArea inherits TouchArea {
    in property <string> tooltip;
    property <bool> tip-done;
    accessible-role: none;

    changed has-hover => {
        if !self.has-hover {
            root.tip-done = false;
            if Tip.text == root.tooltip {
                Tip.shown = false;
            }
        }
    }

    Timer {
        interval: Theme.tooltip-delay;
        running: root.has-hover && root.tooltip != "" && !root.tip-done;
        triggered => {
            Tip.text = root.tooltip;
            Tip.x = root.absolute-position.x + root.mouse-x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.above = root.absolute-position.y;
            Tip.shown = true;
            root.tip-done = true;
        }
    }
}

// What every control does: hover, press, a click from the mouse or from
// Enter or Space, keyboard focus with the ring (Slint scrolls it into view),
// and its tooltip. A control puts this inside itself (`width: 100%; height:
// 100%`), sets its own accessible role and label, and forwards its focus
// here (`forward-focus: p;`).
//
// A disabled control takes no clicks and no focus, but still shows its
// tooltip ("Stop: not possible now"), as a disabled button's `title` does.
export component Pressable {
    in property <bool> enabled: true;
    // False: the keyboard only (the mouse goes through to what is under it).
    in property <bool> mouse: true;
    in property <string> tooltip;
    // True for the title bar's and the bottom bar's controls (outside the
    // view's `ScrollArea`), for the keyboard test.
    in property <bool> in-bar;
    in property <length> ring-radius: Theme.focus-radius;
    // A ring around the control (`outline-offset: 2px`, the switch) rather
    // than inside its edge.
    in property <length> ring-outset: 0px;
    in property <bool> show-ring: true;
    // The gallery's way to show a state without a mouse or keyboard.
    in property <bool> demo-hover;
    in property <bool> demo-pressed;
    in property <bool> demo-focus;
    out property <bool> hovered: (ta.has-hover && root.enabled) || root.demo-hover;
    out property <bool> pressed: (ta.pressed && root.enabled) || root.demo-pressed;
    out property <bool> focused: fs.has-focus || root.demo-focus;
    callback clicked();
    // Any key but Enter and Space (arrows between rows); `reject` passes it on.
    callback navigate(event: KeyEvent) -> EventResult;
    callback focus-changed(has-focus: bool);
    // The tooltip has shown once during this hover: not again until the
    // mouse leaves (and not after a click).
    property <bool> tip-done;

    forward-focus: fs;

    public function focus-me() {
        fs.focus();
    }

    ta := TouchArea {
        // Enabled even for a disabled control: its tooltip still shows.
        mouse-cursor: root.enabled && root.mouse ? MouseCursor.pointer : MouseCursor.default;
        enabled: root.mouse;
        clicked => {
            Tip.shown = false;
            root.tip-done = true;
            if root.enabled {
                root.clicked();
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.tip-done = false;
                if Tip.text == root.tooltip {
                    Tip.shown = false;
                }
            }
        }
    }

    fs := FocusScope {
        x: 0;
        // Clicks go to the touch area; the focus comes from the keyboard.
        width: 0;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return {
                root.clicked();
                return accept;
            }
            if event.text == Key.Space {
                return accept;
            }
            root.navigate(event)
        }
        key-released(event) => {
            if event.text == Key.Space {
                root.clicked();
                return accept;
            }
            reject
        }
        focus-gained(reason) => {
            FocusProbe.focused-x = root.absolute-position.x;
            FocusProbe.focused-top = root.absolute-position.y;
            FocusProbe.focused-bottom = root.absolute-position.y + root.height;
            FocusProbe.focused-in-bar = root.in-bar;
            FocusProbe.focused-serial += 1;
            root.probe();
            root.focus-changed(true);
        }
        focus-lost(reason) => {
            root.focus-changed(false);
        }
    }

    // Where it is now, while it has the focus (the list scrolls it).
    property <length> top-now: root.absolute-position.y;
    changed top-now => {
        if fs.has-focus {
            root.probe();
        }
    }
    function probe() {
        FocusProbe.now-top = root.absolute-position.y;
        FocusProbe.now-bottom = root.absolute-position.y + root.height;
    }

    // Once per hover, where the mouse was when it showed; it does not follow
    // the mouse.
    Timer {
        interval: Theme.tooltip-delay;
        running: ta.has-hover && root.tooltip != "" && !root.tip-done && !ta.pressed;
        triggered => {
            Tip.text = root.tooltip;
            Tip.x = root.absolute-position.x + ta.mouse-x;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.above = root.absolute-position.y;
            Tip.shown = true;
            root.tip-done = true;
        }
    }

    @children

    FocusRing {
        x: -root.ring-outset;
        y: -root.ring-outset;
        width: root.width + 2 * root.ring-outset;
        height: root.height + 2 * root.ring-outset;
        border-radius: root.ring-radius;
        shown: root.show-ring && root.focused && root.enabled;
    }
}
