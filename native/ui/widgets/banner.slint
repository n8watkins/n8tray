// Banners (`.banner`): the PowerShell tray note, an update and its
// progress, a settings error; and the one amber line under the title bar
// that says what is wrong.
import { Theme, Level } from "../theme.slint";
import { Glyph, GlyphName, Label, Pressable, WrapLabel } from "base.slint";
import { SmallButton } from "buttons.slint";
import { ProgressBar } from "status.slint";

export enum BannerKind { info, attention, problem }

// A banner: a glyph, the text (and a smaller detail line), a progress bar
// while something downloads, and up to two buttons. Buttons that do not
// fit beside the text go under it, at the right, as today's `flex-wrap`.
// `link` adds an inline "Learn more" style link at the end of the text,
// which expands `more` under it.
export component Banner {
    in property <BannerKind> kind: BannerKind.info;
    in property <GlyphName> glyph: GlyphName.none;
    in property <string> text;
    in property <string> detail;
    // From 0 to 1; below 0, no bar.
    in property <float> progress: -1;
    in property <string> progress-label: "Update download";
    in property <string> secondary;
    in property <string> primary;
    // The inline link's words while closed and open, and what it opens.
    in property <string> link;
    in property <string> link-open;
    in property <string> more;
    in-out property <bool> expanded;
    // Announced when it appears or changes: a problem at once (`alert`), the
    // rest politely (`status`).
    in property <bool> announce: true;
    in property <bool> demo-link-focus;
    callback secondary-clicked();
    callback primary-clicked();

    property <bool> has-actions: root.secondary != "" || root.primary != "";
    // `.banner.update .grow { flex: 1 1 170px }`: the buttons wrap under the
    // text when the text would get less than 170 px beside them.
    property <length> beside: root.width - 24px - (root.glyph != GlyphName.none ? 14px + 8px : 0px) - 8px;
    property <bool> wrap-actions: root.has-actions && root.beside - actions.preferred-width < 170px;

    accessible-role: groupbox;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-live-region: !root.announce ? AccessibleLiveness.off
        : root.kind == BannerKind.problem ? AccessibleLiveness.assertive
        : AccessibleLiveness.polite;
    min-height: l.preferred-height;

    Rectangle {
        border-radius: Theme.radius-card;
        background: root.kind == BannerKind.problem ? Theme.problem-bg
            : root.kind == BannerKind.attention ? Theme.attention-bg
            : Theme.off-bg;
        border-width: Theme.contrast ? 1px : 0px;
        border-color: Theme.frame;
    }

    l := VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 0px;

        HorizontalLayout {
            spacing: 8px;

            if root.glyph != GlyphName.none: VerticalLayout {
                // A banner with a link reads as a paragraph: the glyph sits
                // at its first line (`align-items: flex-start`, 2px down).
                alignment: root.link != "" ? LayoutAlignment.start : LayoutAlignment.center;
                padding-top: root.link != "" ? 2px : 0px;
                Glyph {
                    name: root.glyph;
                    colorize: Theme.fg;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;

                if root.link == "": WrapLabel {
                    text: root.text;
                    font-size: Theme.text-small;
                    line-height-factor: Theme.line-factor;
                    min-height: self.font-size * Theme.line-height;
                }
                if root.link != "": text-link := StyledText {
                    // The words, then the link inline, as today's paragraph.
                    text: @markdown("\{root.text} [\{root.expanded ? root.link-open : root.link}](more)");
                    default-color: Theme.fg;
                    default-font-size: Theme.text-small;
                    link-color: Theme.link;
                    link-clicked(target) => {
                        root.expanded = !root.expanded;
                    }
                }
                // `.more-text { margin-top: 6px }`
                if root.link != "" && root.expanded: VerticalLayout {
                    padding-top: 6px;
                    WrapLabel {
                        text: root.more;
                        font-size: Theme.text-small;
                        color: Theme.muted;
                        line-height-factor: Theme.line-factor;
                    }
                }
                if root.detail != "": WrapLabel {
                    text: root.detail;
                    font-size: Theme.text-small;
                    color: Theme.muted;
                    line-height-factor: Theme.line-factor;
                    min-height: self.font-size * Theme.line-height;
                }
                if root.progress >= 0: VerticalLayout {
                    padding-top: 5px;
                    ProgressBar {
                        value: root.progress;
                        label: root.progress-label;
                    }
                }
            }

            if root.has-actions && !root.wrap-actions: VerticalLayout {
                alignment: center;
                Rectangle {
                    // The same buttons as `actions`, measured there.
                    min-width: actions.preferred-width;
                }
            }
        }

        // The buttons: beside the text (laid over the room kept above) or on
        // a line of their own, right-aligned.
        if root.wrap-actions: HorizontalLayout {
            alignment: end;
            padding-top: 6px;
            Rectangle {
                min-width: actions.preferred-width;
                height: actions.preferred-height;
            }
        }
    }

    actions := HorizontalLayout {
        spacing: 6px;
        x: root.width - 12px - self.preferred-width;
        y: root.wrap-actions ? root.height - 8px - self.preferred-height : (root.height - self.preferred-height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        visible: root.has-actions;

        if root.secondary != "": SmallButton {
            text: root.secondary;
            clicked => {
                root.secondary-clicked();
            }
        }
        if root.primary != "": SmallButton {
            text: root.primary;
            primary: true;
            clicked => {
                root.primary-clicked();
            }
        }
    }

    // The inline link, from the keyboard: Enter or Space opens and closes
    // the paragraph under it; the ring goes round the text.
    if root.link != "": link-key := Pressable {
        x: 12px + (root.glyph != GlyphName.none ? 22px : 0px) - 2px;
        y: 6px;
        width: root.width - self.x - 10px;
        height: root.height - 12px;
        // The mouse uses the link itself.
        mouse: false;
        demo-focus: root.demo-link-focus;
        accessible-role: button;
        accessible-label: root.expanded ? root.link-open : root.link;
        accessible-expandable: true;
        accessible-expanded: root.expanded;
        accessible-action-default => {
            root.expanded = !root.expanded;
        }
        accessible-action-expand => {
            root.expanded = true;
        }
        clicked => {
            root.expanded = !root.expanded;
        }
    }
}

// The one amber line under the title bar when something is wrong: what is
// wrong, in bold, then a quieter detail ("· 1.9 GB in all").
export component AlertLine {
    in property <string> text;
    in property <string> detail;

    accessible-role: AccessibleRole.text;
    accessible-label: root.detail != "" ? root.text + " " + root.detail : root.text;
    accessible-live-region: AccessibleLiveness.polite;
    min-height: l.preferred-height;

    Rectangle {
        border-radius: Theme.radius-card;
        background: Theme.attention-bg;
        border-width: Theme.contrast ? 1px : 0px;
        border-color: Theme.frame;
    }

    l := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;

        Label {
            text: root.text;
            font-size: Theme.text-link;
            font-weight: Theme.weight-bold;
            horizontal-stretch: 0;
            max-width: self.preferred-width;
        }
        if root.detail != "": Label {
            text: root.detail;
            font-size: Theme.text-small;
            color: Theme.muted;
            horizontal-stretch: 1;
            min-width: 0px;
        }
    }
}
