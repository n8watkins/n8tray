// The scrolling part of the window (`.flyout-body`, `scrollbar-width:
// thin`): its children are stacked; it is as tall as they are until the
// window's height limit, then only it scrolls, with a thin scrollbar that
// widens under the mouse, as WebView2's overlay scrollbar on Windows 11.
// The control that takes the keyboard focus is scrolled into view.
import { Theme } from "../theme.slint";
import { Reveal } from "base.slint";

export component ScrollArea {
    // The height the children want; the screen sizes the window from it.
    out property <length> content-height: inner.preferred-height;
    // How far it is scrolled, from 0 down.
    out property <length> scrolled: -fl.content-y;
    property <length> maximum: max(0px, root.content-height - root.height);
    property <bool> overflows: root.maximum > 0.5px;
    in property <bool> demo-scrollbar-hover;

    accessible-role: none;
    preferred-height: root.content-height;
    min-height: 0px;
    vertical-stretch: 1;

    fl := Flickable {
        width: root.width;
        height: root.height;
        content-width: root.width;
        content-height: max(root.height, root.content-height);

        inner := VerticalLayout {
            width: root.width;
            alignment: start;
            @children
        }
    }

    // A control under the scroll area took the focus: bring it into view.
    property <int> reveal: Reveal.serial;
    changed reveal => {
        // Where it is relative to the visible part (its position already
        // includes the scrolling).
        if !root.overflows {
            return;
        }
        let content-top = inner.absolute-position.y;
        if Reveal.top < content-top || Reveal.bottom > content-top + inner.height {
            return;
        }
        let view-top = fl.absolute-position.y;
        if Reveal.top < view-top {
            fl.content-y = min(0px, fl.content-y + (view-top - Reveal.top));
        } else if Reveal.bottom > view-top + root.height {
            fl.content-y = max(-root.maximum, fl.content-y - (Reveal.bottom - view-top - root.height));
        }
    }

    // The scrollbar: a 2 px line at rest, 6 px on a soft track under the
    // mouse; the thumb can be dragged.
    if root.overflows: bar := Rectangle {
        property <bool> wide: bar-ta.has-hover || bar-ta.pressed || root.demo-scrollbar-hover;
        property <length> track: root.height - 4px;
        property <length> thumb-height: max(16px, self.track * root.height / root.content-height);
        x: root.width - Theme.scrollbar - 2px;
        y: 2px;
        width: Theme.scrollbar;
        height: self.track;
        border-radius: Theme.scrollbar / 2;
        background: self.wide && !Theme.contrast ? Theme.hover : transparent;

        thumb := Rectangle {
            width: bar.wide ? Theme.scrollbar : 2px;
            x: parent.width - self.width - (bar.wide ? 0px : 1px);
            height: bar.thumb-height;
            y: root.maximum > 0 ? (bar.track - self.height) * (-fl.content-y / root.maximum) : 0px;
            border-radius: self.width / 2;
            background: Theme.contrast ? Theme.system.canvas-text : Theme.faint.with-alpha(bar.wide ? 0.7 : 0.5);
            animate width, x { duration: 150ms; easing: ease-out; }
        }

        bar-ta := TouchArea {
            property <length> start-offset;
            property <length> start-y;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    self.start-offset = -fl.content-y;
                    self.start-y = self.mouse-y;
                }
            }
            moved => {
                if self.pressed && bar.track > bar.thumb-height {
                    let wanted = self.start-offset + (self.mouse-y - self.start-y) * root.maximum / (bar.track - bar.thumb-height);
                    fl.content-y = -max(0px, min(root.maximum, wanted));
                }
            }
        }
    }
}
