// The golden image tests' font (Inter, OFL: see fonts/OFL.txt): creating
// this component registers it, so the tests' renders do not depend on the
// fonts of the machine that runs them. Compiled into test builds only.
import "fonts/Inter-VariableFont.ttf";

export component TestFont inherits Window {
    width: 1px;
    height: 1px;
}
